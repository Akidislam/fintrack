# FinTrack Server Environment Configuration

# Server Port
PORT=5000

# Allowed CORS Origins (comma-separated for multiple web origins)
CLIENT_ORIGIN=http://localhost:5173

# Environment Mode (development | production)
NODE_ENV=development

# PostgreSQL Connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/fintrack

# JWT Secret for Session Authentication (change to a strong random key in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
